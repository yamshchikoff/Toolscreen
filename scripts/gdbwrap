#!/usr/bin/env python3
"""Интерактивная обёртка над GDB через pexpect.

Сессия хранится в /tmp/gdbwrap/session.
attach <pid>  — аттач
cmd <command> — выполнить команду, вернуть вывод
detach        — отсоединиться
"""

import os, sys, pickle, pexpect

SESSION = "/tmp/gdbwrap/session"
SUDO_PASS = "rabbit chess"

def attach(pid):
    """Аттачиться и сохранить сессию."""
    os.makedirs(os.path.dirname(SESSION), exist_ok=True)
    cmd = f"sudo -S gdb --pid {pid} -q"
    child = pexpect.spawn(cmd, encoding='utf-8', timeout=30, codec_errors='replace')
    child.expect_exact("password")
    child.sendline(SUDO_PASS)
    child.expect_exact("(gdb)")
    # Убираем пагинацию
    child.sendline("set pagination off")
    child.expect_exact("(gdb)")
    child.sendline("set confirm off")
    child.expect_exact("(gdb)")
    with open(SESSION, 'wb') as f:
        pickle.dump(child, f)
    print(f"GDB_ATTACHED pid={pid}")

def cmd(command):
    """Выполнить команду в активной сессии."""
    with open(SESSION, 'rb') as f:
        child = pickle.load(f)
    child.sendline(command)
    try:
        child.expect_exact("(gdb)", timeout=5)
    except pexpect.TIMEOUT:
        pass
    output = child.before if child.before else "(no output)"
    with open(SESSION, 'wb') as f:
        pickle.dump(child, f)
    return output

def detach():
    """Detach и закрыть сессию."""
    if os.path.exists(SESSION):
        try:
            cmd("detach")
        except:
            pass
        try:
            cmd("quit")
        except:
            pass
        os.unlink(SESSION)
    print("DETACHED")

if __name__ == '__main__':
    if len(sys.argv) < 2:
        print("Usage: gdbwrap attach <pid> | cmd <command> | detach")
        sys.exit(1)

    action = sys.argv[1]

    if action == 'attach':
        attach(sys.argv[2])
    elif action == 'cmd':
        result = cmd(' '.join(sys.argv[2:]))
        print(result)
    elif action == 'detach':
        detach()
    else:
        print(f"Unknown: {action}")
