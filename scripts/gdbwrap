#!/usr/bin/env python3
"""Персистентная GDB-сессия."""

import os, sys, time, pexpect

DIR = "/tmp/gdbwrap"
os.makedirs(DIR, exist_ok=True)

READY = f"{DIR}/ready"
STOP  = f"{DIR}/stop"
CMD   = f"{DIR}/cmd"
OUT   = f"{DIR}/out"

def start(args):
    """Запустить gdb и войти в серверный цикл."""
    cleanup()

    # Добавляем -ex команды для отключения пагинации СРАЗУ
    gdb_args = list(args)
    gdb_args[1:1] = ['-iex="set pagination off"', '-ex="set confirm off"']
    cmdline = " ".join(gdb_args)
    child = pexpect.spawn(cmdline, encoding='utf-8', timeout=60, codec_errors='replace')

    # Стартовый диалог: ждём (gdb), обрабатывая debuginfod
    while True:
        i = child.expect_exact(["(gdb)", "debuginfod"], timeout=60)
        if i == 1:
            child.sendline("n")
        else:
            break

    # Сигнал: сервер готов. Очищаем буфер от init-команд.
    child.before = ""
    open(READY, 'w').close()
    sys.stdout.write(f"READY {child.pid}\n")
    sys.stdout.flush()
    # Также пишем в файл для отладки
    with open(f"{DIR}/log", 'a') as lf:
        lf.write(f"READY {child.pid}\n")

    # Серверный цикл
    while not os.path.exists(STOP):
        if os.path.exists(CMD):
            with open(CMD) as f:
                cmd_text = f.read().strip()
            if cmd_text:
                os.remove(CMD)
                # Синхронизация: ждём (gdb) если ещё не на нём
                try:
                    child.expect_exact("(gdb)", timeout=0.5)
                except:
                    pass
                # Отправляем команду
                child.sendline(cmd_text)
                # Ждём следующий (gdb)
                try:
                    child.expect_exact("(gdb)", timeout=120)
                except pexpect.EOF:
                    output = "[EOF] " + (child.before or "")
                except pexpect.TIMEOUT:
                    output = "[TIMEOUT] " + (child.before or "")
                else:
                    output = child.before if child.before else "(no output)"
                with open(OUT, 'w') as f:
                    f.write(output)
        time.sleep(0.1)

    # Остановка
    try: child.sendline("quit"); child.close()
    except: pass
    cleanup()
    print("STOPPED")

def cmd(command, timeout=30):
    """Послать команду, дождаться ответа."""
    # Ждём готовности сервера
    deadline = time.time() + 10
    while not os.path.exists(READY):
        time.sleep(0.1)
        if time.time() > deadline:
            return "TIMEOUT: server not ready"

    # Очищаем старый вывод
    for f in [OUT, CMD]:
        if os.path.exists(f):
            os.remove(f)

    # Пишем команду
    with open(CMD, 'w') as f:
        f.write(command + "\n")

    # Ждём ответ (сервер создаст OUT)
    deadline = time.time() + timeout
    while not os.path.exists(OUT):
        time.sleep(0.1)
        if time.time() > deadline:
            return "TIMEOUT: no response"

    time.sleep(0.1)  # дать fs синхронизироваться
    with open(OUT) as f:
        return f.read()

def stop():
    open(STOP, 'w').close()
    time.sleep(0.5)
    cleanup()

def cleanup():
    for f in [READY, STOP, CMD, OUT]:
        if os.path.exists(f):
            os.remove(f)

if __name__ == '__main__':
    if len(sys.argv) < 2:
        print("Usage: gdbwrap start <gdb-args> | cmd <command> | stop"); sys.exit(1)
    action = sys.argv[1]
    if action == 'start': start(sys.argv[2:])
    elif action == 'cmd': print(cmd(' '.join(sys.argv[2:])), end='')
    elif action == 'stop': stop()
    else: print(f"Unknown: {action}")
